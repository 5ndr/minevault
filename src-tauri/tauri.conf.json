{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineVault",
  "version": "0.1.3",
  "identifier": "com.minevault.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MineVault - Minecraft Backup Manager",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
